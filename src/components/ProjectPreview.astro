---
import type { CollectionEntry } from 'astro:content';
import ProjectMedia from './ProjectMedia.astro';
import ProjectMeta from './ProjectMeta.astro';
import { workMedia } from '../data/workMedia';
interface Props { entry: CollectionEntry<'work'>; mode?: 'featured' | 'compact' | 'index'; eager?: boolean; }
const { entry, mode = 'compact', eager = false } = Astro.props;
const slug = entry.id.replace(/\.md$/, '');
const media = workMedia[slug];
const compact = mode === 'compact';
---

<article class:list={['project-preview', `mode-${mode}`]}>
  <ProjectMedia media={media} compact={compact} eager={eager} />
  <div class="preview-copy">
    <p class="utility">{entry.data.context}</p>
    <h2>{entry.data.title}</h2>
    <ProjectMeta status={entry.data.status} role={entry.data.role} period={entry.data.period} compact={compact} />
    <p class="summary">{entry.data.summary}</p>
    <a href={`/work/${slug}`}>Открыть кейс</a>
  </div>
</article>

<style>
  .project-preview { overflow: hidden; border: 1px solid var(--color-line); border-radius: var(--radius-surface); background: var(--color-surface); }
  .mode-featured { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(320px, 0.75fr); }
  .mode-featured :global(.project-media) { border-right: 1px solid var(--color-line); }
  .preview-copy { padding: 1.6rem; }
  .preview-copy h2 { margin: 0.7rem 0 1rem; }
  .summary { margin: 1.35rem 0; color: var(--color-body); }
  .preview-copy > a { display: inline-block; padding-bottom: 0.15rem; }
  .mode-compact .preview-copy h2 { font-size: clamp(1.65rem, 3vw, 2.4rem); }
  @media (max-width: 840px) { .mode-featured { grid-template-columns: 1fr; } .mode-featured :global(.project-media) { border-right: 0; border-bottom: 1px solid var(--color-line); } }
</style>
