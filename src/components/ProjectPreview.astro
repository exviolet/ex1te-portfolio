---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import ProjectMedia from './ProjectMedia.astro';
import ProjectMeta from './ProjectMeta.astro';
import { workMedia } from '../data/workMedia';
/* Two modes, not three: 'compact' was declared, defaulted to, and never passed.
   'featured' is the wide media-beside-copy card at the top of /work; 'index'
   is a cell in the row below it. */
interface Props { entry: CollectionEntry<'work'>; mode?: 'featured' | 'index'; eager?: boolean; }
const { entry, mode = 'index', eager = false } = Astro.props;
const slug = entry.id.replace(/\.md$/, '');
const media = workMedia[slug];
/* The index cells are ~400px wide in a three-across row, where the 410px media
   frame turned every screenshot into a tall portrait crop. */
const compact = mode === 'index';
---

<article class:list={['project-preview', `mode-${mode}`]}>
  <ProjectMedia media={media} compact={compact} eager={eager} />
  <div class="preview-copy">
    <p class="utility">{entry.data.context}</p>
    <h2>{entry.data.title}</h2>
    <ProjectMeta status={entry.data.status} role={entry.data.role} period={entry.data.period} compact={compact} />
    <p class="summary">{entry.data.summary}</p>
    {/* The homepage said "Открыть кейс" with an arrow and this one did not,
        for no reason anyone recorded. Same action, same glyph, and the icon
        moves the way it points. */}
    <a class="preview-open" href={`/work/${slug}`}>Открыть кейс<Icon name="arrow-right" size={15} /></a>
  </div>
</article>

<style>
  .project-preview { overflow: hidden; border: 1px solid var(--color-line); border-radius: var(--radius-surface); background: var(--color-surface); }
  .mode-featured { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(320px, 0.75fr); }
  .mode-featured :global(.project-media) { border-right: 1px solid var(--color-line); }
  .preview-copy { padding: 1.6rem; }
  .preview-copy h2 { margin: 0.7rem 0 1rem; }
  .summary { margin: 1.35rem 0; color: var(--color-body); }
  .preview-open { display: inline-flex; align-items: center; gap: 0.5rem; padding-block: 0.35rem; font-family: var(--font-utility); font-size: 0.8rem; text-decoration: none; }
  .preview-open:hover { color: var(--color-accent); }
  /* Sized against the card, not the viewport: the global h2 clamp reads 3.4vw,
     which on a wide screen set "InteractiveLAB" larger than its own ~400px
     cell and clipped it. `break-word` is the guard for a longer name later. */
  .mode-index .preview-copy h2 { font-size: clamp(1.35rem, 1.6vw, 1.85rem); overflow-wrap: break-word; }
  .mode-index .preview-copy { padding: 1.3rem; }
  @media (max-width: 840px) { .mode-featured { grid-template-columns: 1fr; } .mode-featured :global(.project-media) { border-right: 0; border-bottom: 1px solid var(--color-line); } }
</style>
