---
import { contact } from '../data/contact';
---

<div class="contact-links">
  <a class="pill" href={contact.github}>GitHub</a>
  <a class="pill" href={contact.telegram}>Telegram</a>
  <a class="pill" href={contact.instagram}>Instagram</a>
  <a class="pill" href={contact.cv}>Скачать CV</a>
</div>

<style>
  .contact-links { display: flex; flex-wrap: wrap; gap: 0.6rem; }
</style>
