---
/* Site-wide motion, driven by GSAP. Everything here is enhancement only:
   `html[data-motion="ready"]` is set by BaseLayout's inline script and only when
   the visitor has not asked for reduced motion, so the hidden-then-revealed
   states never apply unless something is actually going to animate them. */
---

<style is:global>
  html[data-motion='ready'] [data-reveal] { opacity: 0; }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  if (document.documentElement.dataset.motion === 'ready') {
    gsap.registerPlugin(ScrollTrigger);

    /* 1. The name assembles letter by letter. Short and tight — a long cascade
          would turn the first thing a recruiter sees into a loading screen. */
    const chars = document.querySelectorAll('.split-char');
    if (chars.length) {
      gsap.fromTo(
        chars,
        { opacity: 0, yPercent: 45 },
        {
          opacity: 1,
          yPercent: 0,
          duration: 0.65,
          ease: 'power3.out',
          stagger: { each: 0.022, from: 'start' },
        },
      );
    }

    /* 2. Sections arrive on scroll. Deliberately restrained: 14px, once only,
          no scrub. Overdone scroll reveals are the classic tell. */
    for (const el of document.querySelectorAll<HTMLElement>('[data-reveal]')) {
      gsap.fromTo(
        el,
        { opacity: 0, y: 14 },
        {
          opacity: 1,
          y: 0,
          duration: 0.55,
          ease: 'power2.out',
          scrollTrigger: { trigger: el, start: 'top 88%', once: true },
        },
      );
    }

    /* 3. The footer watermark. Three layers on one element, which is what keeps
          it from reading as decoration: an ambient scroll parallax, a secondary
          lean towards the pointer, and — as the primary action — a spotlight
          that reveals a brighter copy of the letters under the cursor.
          Personality is Premium throughout: decelerating curves, no overshoot.
          Nothing here moves on its own; every layer answers an input. */
    const ghost = document.querySelector<HTMLElement>('[data-ghost]');
    const footer = document.querySelector<HTMLElement>('.site-footer');

    if (ghost && footer) {
      // Ambient: scrub-linked, so linear is correct — the scroll IS the easing.
      gsap.fromTo(
        ghost,
        { yPercent: 14 },
        {
          yPercent: -4,
          ease: 'none',
          scrollTrigger: { trigger: footer, start: 'top bottom', end: 'bottom bottom', scrub: 0.6 },
        },
      );

      if (!window.matchMedia('(pointer: coarse)').matches) {
        // Secondary lean: slower than the spotlight so the two read as separate
        // depths rather than one rigid block tracking the mouse.
        const leanX = gsap.quickTo(ghost, 'x', { duration: 0.9, ease: 'power3.out' });

        // Primary: trailing light. Damped rather than 1:1 — exact tracking is
        // the thing that feels robotic.
        const spotX = gsap.quickTo(ghost, '--spot-x', { duration: 0.42, ease: 'power3.out' });
        const spotY = gsap.quickTo(ghost, '--spot-y', { duration: 0.42, ease: 'power3.out' });

        gsap.set(ghost, { '--spot-o': 0, '--spot-x': 0, '--spot-y': 0 });

        footer.addEventListener('pointermove', (event) => {
          const box = ghost.getBoundingClientRect();
          spotX(event.clientX - box.left);
          spotY(event.clientY - box.top);
          const rect = footer.getBoundingClientRect();
          leanX(((event.clientX - rect.left) / rect.width - 0.5) * 36);
        });

        // Entrance decelerates and outlasts the exit, per the usual asymmetry:
        // arrival is worth watching, departure is not.
        footer.addEventListener('pointerenter', () => {
          gsap.to(ghost, { '--spot-o': 1, duration: 0.4, ease: 'power2.out' });
        });

        footer.addEventListener('pointerleave', () => {
          gsap.to(ghost, { '--spot-o': 0, duration: 0.24, ease: 'power2.in' });
          leanX(0);
        });
      }
    }
  }
</script>
