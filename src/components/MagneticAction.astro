---
---

<span class="magnetic-action" data-magnetic-action><slot /></span>

<script>
  const magnetic = matchMedia('(any-hover: hover) and (any-pointer: fine) and (prefers-reduced-motion: no-preference)');
  for (const area of document.querySelectorAll<HTMLElement>('[data-magnetic-action]')) {
    const reset = () => {
      area.style.removeProperty('--magnet-x');
      area.style.removeProperty('--magnet-y');
      delete area.dataset.tracking;
    };

    area.addEventListener('pointermove', (event) => {
      if (!magnetic.matches || event.pointerType !== 'mouse') return;
      const { left, top, width, height } = area.getBoundingClientRect();
      const x = Math.max(-6, Math.min(6, (event.clientX - left - width / 2) * 0.18));
      const y = Math.max(-4, Math.min(4, (event.clientY - top - height / 2) * 0.18));
      area.style.setProperty('--magnet-x', `${x}px`);
      area.style.setProperty('--magnet-y', `${y}px`);
      area.dataset.tracking = '';
    });
    area.addEventListener('pointerleave', reset);
    area.addEventListener('pointercancel', reset);
    magnetic.addEventListener('change', reset);
  }
</script>

<style>
  .magnetic-action { display: inline-grid; }

  @media (any-hover: hover) and (any-pointer: fine) and (prefers-reduced-motion: no-preference) {
    .magnetic-action > :global(.pill) {
      translate: var(--magnet-x, 0px) var(--magnet-y, 0px);
      transition:
        color var(--dur-quick) var(--ease-signature),
        background-color var(--dur-quick) var(--ease-signature),
        border-color var(--dur-quick) var(--ease-signature),
        translate var(--dur-base) var(--ease-spring),
        transform var(--dur-base) var(--ease-spring);
    }

    .magnetic-action[data-tracking] > :global(.pill) {
      transition-duration: var(--dur-quick), var(--dur-quick), var(--dur-quick), var(--dur-quick), var(--dur-base);
      transition-timing-function: var(--ease-signature), var(--ease-signature), var(--ease-signature), var(--ease-signature), var(--ease-spring);
    }

    .magnetic-action > :global(.pill:focus-visible) { translate: none; }
    .magnetic-action > :global(.pill:active) {
      transform: scale(1.035, 0.94);
      transition-duration: var(--dur-quick);
    }
  }
</style>
