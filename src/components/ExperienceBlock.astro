---
import { experience } from '../data/experience';
---

<section class="experience-block">
  <header>
    <div><h2>{experience.company}</h2><p>{experience.relationship}</p></div>
    <time>{experience.period}</time>
  </header>
  {experience.stages.map((stage) => (
    <article>
      <time>{stage.period}</time>
      <h3>{stage.title}</h3>
      <p>{stage.detail}</p>
    </article>
  ))}
</section>

<style>
  .experience-block { border-top: 1px solid var(--color-line); }
  header { display: grid; grid-template-columns: 1fr auto; gap: 1.5rem; padding: 1.5rem 0; border-bottom: 1px solid var(--color-line); }
  header h2 { font-size: clamp(1.8rem, 3vw, 2.8rem); }
  header p, header time { color: var(--color-muted); }
  article { display: grid; grid-template-columns: 150px 220px 1fr; gap: 1.5rem; padding: 1.35rem 0; border-bottom: 1px solid var(--color-line); }
  article time, article p { color: var(--color-muted); }
  article h3 { font-size: 1.05rem; letter-spacing: 0; }
  @media (max-width: 760px) { header, article { grid-template-columns: 1fr; gap: 0.5rem; } }
</style>
