---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { workMedia } from '../data/workMedia';

interface Props { entries: CollectionEntry<'work'>[]; }
const { entries } = Astro.props;

const statusLabels = {
  production: 'production',
  'pre-launch': 'pre-launch',
  released: 'released',
  building: 'in development',
} as const;

const items = entries.map((entry) => {
  const slug = entry.id.replace(/\.md$/, '');
  return { slug, entry, media: workMedia[slug] };
});
---

{/* Projects as workspaces: rail + panel. Radio inputs are the source of truth, so
    switching works with zero JavaScript; GSAP only animates the handover.
    The inputs must be siblings of both .rail and .panels for `~` to reach them. */}
<div class="workspaces" data-workspaces>
  {items.map((item, index) => (
    <input
      type="radio"
      name="workspace"
      id={`ws-${item.slug}`}
      class="visually-hidden ws-input"
      checked={index === 0}
      aria-label={`Рабочее пространство ${index + 1}: ${item.entry.data.title}`}
    />
  ))}

  <div class="rail">
    {items.map((item, index) => (
      <label class="rail-item" for={`ws-${item.slug}`}>
        <span class="rail-number">{String(index + 1).padStart(2, '0')}</span>
        <span class="rail-name">{item.slug}</span>
      </label>
    ))}
  </div>

  <div class="panels">
    {items.map((item) => (
      <article class="panel" data-panel>
        <div class="panel-media">
          {item.media?.hero
            ? <Image src={item.media.hero} alt={item.media.heroAlt} loading="lazy" />
            : <p class="panel-placeholder">{item.media?.placeholder}</p>}
        </div>
        <div class="panel-copy">
          <p class="panel-status">{statusLabels[item.entry.data.status]} <span>//</span> {item.entry.data.context}</p>
          <h3>{item.entry.data.title}</h3>
          <p class="panel-summary">{item.entry.data.summary}</p>
          <dl class="panel-facts">
            <div><dt>Роль</dt><dd>{item.entry.data.role}</dd></div>
            <div><dt>Период</dt><dd>{item.entry.data.period}</dd></div>
            <div><dt>Команда</dt><dd>{item.entry.data.team}</dd></div>
          </dl>
          {/* Arrow points right: opening a case moves the reader forward. */}
          <a class="panel-open" href={`/work/${item.slug}`}>
            Открыть кейс<Icon name="arrow-right" size={16} />
          </a>
        </div>
      </article>
    ))}
  </div>
</div>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .workspaces { display: grid; grid-template-columns: 190px minmax(0, 1fr); gap: 1.5rem; }
  .rail { grid-column: 1; display: grid; align-content: start; }
  .panels { grid-column: 2; display: grid; }

  .rail-item {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.7rem 0 0.7rem 0.85rem;
    border-left: 2px solid var(--color-line);
    color: var(--color-muted);
    font-family: var(--font-utility);
    font-size: 0.82rem;
    cursor: pointer;
    /* A label is neither `a` nor `button`, so the global colour rule never
       reached the rail: the panel slid while the rail it belongs to snapped. */
    transition:
      color var(--dur-quick) var(--ease-signature),
      border-color var(--dur-quick) var(--ease-signature);
  }
  .rail-item:hover { color: var(--color-ink); border-left-color: var(--color-line-strong); }
  .rail-number {
    color: var(--color-muted);
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
    transition: color var(--dur-quick) var(--ease-signature);
  }

  .panel {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(310px, 0.9fr);
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-surface);
    background: var(--color-surface);
    visibility: hidden;
  }

  /* Index-paired rules. Covers up to six workspaces; extend if a seventh case lands. */
  .ws-input:nth-of-type(1):checked ~ .rail .rail-item:nth-child(1),
  .ws-input:nth-of-type(2):checked ~ .rail .rail-item:nth-child(2),
  .ws-input:nth-of-type(3):checked ~ .rail .rail-item:nth-child(3),
  .ws-input:nth-of-type(4):checked ~ .rail .rail-item:nth-child(4),
  .ws-input:nth-of-type(5):checked ~ .rail .rail-item:nth-child(5),
  .ws-input:nth-of-type(6):checked ~ .rail .rail-item:nth-child(6) {
    color: var(--color-ink);
    border-left-color: var(--color-accent);
  }

  .ws-input:nth-of-type(1):checked ~ .rail .rail-item:nth-child(1) .rail-number,
  .ws-input:nth-of-type(2):checked ~ .rail .rail-item:nth-child(2) .rail-number,
  .ws-input:nth-of-type(3):checked ~ .rail .rail-item:nth-child(3) .rail-number,
  .ws-input:nth-of-type(4):checked ~ .rail .rail-item:nth-child(4) .rail-number,
  .ws-input:nth-of-type(5):checked ~ .rail .rail-item:nth-child(5) .rail-number,
  .ws-input:nth-of-type(6):checked ~ .rail .rail-item:nth-child(6) .rail-number { color: var(--color-accent); }

  .ws-input:nth-of-type(1):focus-visible ~ .rail .rail-item:nth-child(1),
  .ws-input:nth-of-type(2):focus-visible ~ .rail .rail-item:nth-child(2),
  .ws-input:nth-of-type(3):focus-visible ~ .rail .rail-item:nth-child(3),
  .ws-input:nth-of-type(4):focus-visible ~ .rail .rail-item:nth-child(4),
  .ws-input:nth-of-type(5):focus-visible ~ .rail .rail-item:nth-child(5),
  .ws-input:nth-of-type(6):focus-visible ~ .rail .rail-item:nth-child(6) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Hidden panels keep their space, so switching never shifts the page.
     visibility:hidden also removes their links from the tab order. */
  .ws-input:nth-of-type(1):checked ~ .panels .panel:nth-child(1),
  .ws-input:nth-of-type(2):checked ~ .panels .panel:nth-child(2),
  .ws-input:nth-of-type(3):checked ~ .panels .panel:nth-child(3),
  .ws-input:nth-of-type(4):checked ~ .panels .panel:nth-child(4),
  .ws-input:nth-of-type(5):checked ~ .panels .panel:nth-child(5),
  .ws-input:nth-of-type(6):checked ~ .panels .panel:nth-child(6) { visibility: visible; }

  .panel-media { min-height: 400px; background: var(--color-raised); }
  .panel-media img { width: 100%; height: 100%; min-height: 400px; object-fit: cover; object-position: top left; }
  .panel-placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    padding: 2rem;
    color: var(--color-muted);
    font-size: 0.92rem;
    text-align: center;
  }

  .panel-copy { display: flex; flex-direction: column; padding: 1.75rem; border-left: 1px solid var(--color-line); }
  .panel-status {
    color: var(--color-muted);
    font-family: var(--font-utility);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }
  .panel-status span { color: var(--color-accent); }
  .panel-copy h3 { margin: 0.8rem 0 0.9rem; font-size: clamp(1.5rem, 2.4vw, 2.1rem); }
  .panel-summary { color: var(--color-body); font-size: 1rem; }
  .panel-facts { margin: 1.6rem 0; display: grid; gap: 0.55rem; }
  .panel-facts > div { display: flex; gap: 0.9rem; font-family: var(--font-utility); font-size: 0.74rem; }
  .panel-facts dt { flex: 0 0 64px; color: var(--color-muted); }
  .panel-facts dd { margin: 0; color: var(--color-body); }

  .panel-open {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    align-self: start;
    padding-bottom: 0.2rem;
    border-bottom: 1px solid var(--color-line-strong);
    color: var(--color-ink);
    font-family: var(--font-utility);
    font-size: 0.78rem;
    text-decoration: none;
  }
  .panel-open:hover { border-bottom-color: var(--color-accent); color: var(--color-accent); }

  @media (max-width: 900px) {
    .workspaces { grid-template-columns: 1fr; gap: 1rem; }
    .rail {
      grid-column: 1;
      grid-auto-flow: column;
      grid-auto-columns: max-content;
      overflow-x: auto;
      scrollbar-width: thin;
      /* The rail overflows here (four items need ~500px of a 368px row). A
         scrollbar hint is not an affordance on iOS, which hides it at rest, so
         the clipped edge fades instead — the cut is the signal. */
      mask-image: linear-gradient(to right, #000 calc(100% - 2.75rem), transparent);
    }
    .rail-item {
      padding: 0.75rem 0.9rem 0.9rem;
      border-left: 0;
      border-bottom: 2px solid var(--color-line);
    }
    .rail-item:hover { border-bottom-color: var(--color-line-strong); }
    .ws-input:nth-of-type(1):checked ~ .rail .rail-item:nth-child(1),
    .ws-input:nth-of-type(2):checked ~ .rail .rail-item:nth-child(2),
    .ws-input:nth-of-type(3):checked ~ .rail .rail-item:nth-child(3),
    .ws-input:nth-of-type(4):checked ~ .rail .rail-item:nth-child(4),
    .ws-input:nth-of-type(5):checked ~ .rail .rail-item:nth-child(5),
    .ws-input:nth-of-type(6):checked ~ .rail .rail-item:nth-child(6) { border-bottom-color: var(--color-accent); }
    .panels { grid-column: 1; }
    .panel { grid-template-columns: 1fr; }
    .panel-copy { border-left: 0; border-top: 1px solid var(--color-line); }
    .panel-media, .panel-media img { min-height: 240px; }
  }
  @media (max-width: 520px) {
    .panel-copy { padding: 1.15rem; }
    .panel-facts dt { flex-basis: 58px; }
  }
</style>

<script>
  import gsap from 'gsap';

  /* The one signature interaction. Switching already works through the radio
     inputs alone; this only animates the handover, and stands down entirely
     when the visitor asks for reduced motion. */
  const root = document.querySelector<HTMLElement>('[data-workspaces]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (root) {
    const inputs = [...root.querySelectorAll<HTMLInputElement>('.ws-input')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    let current = inputs.findIndex((i) => i.checked);

    for (const [index, input] of inputs.entries()) {
      input.addEventListener('change', () => {
        if (!input.checked || index === current) return;
        const previous = current;
        const outgoing = panels[previous];
        const incoming = panels[index];
        current = index;

        if (reduced.matches) {
          // Motion may have been switched off after a tween already ran, which
          // would leave a stale inline opacity on a panel that is now showing.
          gsap.killTweensOf(panels);
          gsap.set(panels, { clearProps: 'opacity,transform' });
          return;
        }

        // Direction follows the rail: moving down the list enters from below.
        const forward = index > previous;
        gsap.killTweensOf([outgoing, incoming]);
        gsap.set(outgoing, { opacity: 1 });
        gsap.to(outgoing, { opacity: 0, duration: 0.12, ease: 'power1.out' });
        gsap.fromTo(
          incoming,
          { opacity: 0, y: forward ? 10 : -10 },
          { opacity: 1, y: 0, duration: 0.34, ease: 'power2.out' },
        );
        gsap.fromTo(
          incoming.querySelectorAll('.panel-status, h3, .panel-summary, .panel-facts > div, .panel-open'),
          { opacity: 0, y: forward ? 8 : -8 },
          { opacity: 1, y: 0, duration: 0.3, ease: 'power2.out', stagger: 0.035, delay: 0.04 },
        );
      });
    }
  }
</script>
