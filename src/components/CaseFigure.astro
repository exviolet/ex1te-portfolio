---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { CaseFigure } from '../data/workMedia';
interface Props { figure: CaseFigure; }
const { figure } = Astro.props;
const images = figure.images ?? [];
---

{/* Evidence for the section above it. The prose column is held to a reading
    measure, this steps out to the full shell — that alternation is what breaks
    the even march the case used to scroll as. */}
<figure class="case-figure">
  <div class:list={['case-figure-media', { multi: images.length > 1 }]} style={`--cols: ${Math.max(images.length, 1)}`}>
    {images.map((image) => (
      <div class="case-figure-cell">
        {/* A link to the full-size file: opens full screen through Lightbox,
            or as the bare image without JavaScript. */}
        <a class="case-figure-zoom" href={image.src.src} data-zoom><Image src={image.src} alt={image.alt} loading="lazy" /></a>
      </div>
    ))}
    {/* No autoplay: the demo is proof on demand, not motion the reader has to
        sit through. `preload="metadata"` keeps the poster frame cheap. */}
    {figure.video && (
      <div class="case-figure-cell"><video src={figure.video} controls preload="metadata" playsinline></video></div>
    )}
  </div>
  <figcaption>
    <span class="case-figure-note"><span aria-hidden="true">//</span> {figure.caption}</span>
    {figure.action && (
      <a class="pill" href={figure.action.href}>
        <Icon name={figure.action.icon} size={15} />{figure.action.label}
      </a>
    )}
  </figcaption>
</figure>

<style>
  .case-figure { margin: 2.6rem 0 0; }

  .case-figure-media {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-surface);
    background: var(--color-raised);
  }
  /* A 1px gap over the line colour draws the dividers between images, the same
     way the facts table and the stack grid do it. One column per image: a pair
     of dashboards, or three phone screens read left to right as a sequence. */
  .case-figure-media.multi {
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 1px;
    background: var(--color-line);
  }

  /* Each image sits in its own cell rather than directly in the grid. Images
     side by side are rarely the same height, and without a cell the shorter one
     leaves a band of the divider colour under it. The cell also mounts an image
     narrower than the column centred instead of upscaling it into blur. */
  .case-figure-cell {
    display: grid;
    place-items: center;
    background: var(--color-raised);
  }

  /* One rule for both shapes. A wide screenshot hits `max-width` first and
     fills the column; the portrait A4 report render (1859x2630) hits
     `max-height` first and is scaled down and centred, mounted on the surface
     instead of running for two viewports — the full document is one click away
     in the caption. Scaling the image itself rather than letterboxing it inside
     an oversized box is what keeps the dark gutters from appearing. */
  .case-figure-media :global(img),
  .case-figure-media video {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 760px;
    margin-inline: auto;
  }

  .case-figure-zoom { display: block; max-width: 100%; cursor: zoom-in; }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    margin-top: 0.7rem;
  }
  .case-figure-note { max-width: 62ch; color: var(--color-muted); font-size: 0.78rem; }
  .case-figure-note span { color: var(--color-accent); font-family: var(--font-utility); }

  /* On a phone a pair stacks. Three or more become a strip that scrolls inside
     the figure: stacked, the WhatsApp sequence is three portrait screens — some
     2300px of scroll — and in three columns each phone is 120px wide. */
  @media (max-width: 620px) {
    .case-figure-media.multi { grid-template-columns: 1fr; }
    .case-figure-media.multi[style*='--cols: 3'],
    .case-figure-media.multi[style*='--cols: 4'] {
      grid-template-columns: none;
      grid-auto-columns: 78%;
      grid-auto-flow: column;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
    }
    .case-figure-media.multi > .case-figure-cell { scroll-snap-align: start; }
    .case-figure-media.multi :global(img) { max-height: 560px; }
  }
</style>
