---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { contact } from '../data/contact';

const year = new Date().getFullYear();

const menu = [
  { href: '/', label: 'Главная' },
  { href: '/work', label: 'Работы' },
  { href: '/about', label: 'Обо мне' },
  { href: '/contact', label: 'Контакты' },
];

/* Every entry resolves to a real account. Email is not here on purpose — see
   the note in src/data/contact.ts. */
const socials = [
  { href: contact.github, label: 'GitHub', icon: 'github' },
  { href: contact.telegram, label: 'Telegram', icon: 'telegram' },
  { href: contact.instagram, label: 'Instagram', icon: 'instagram' },
];
---

<footer class="site-footer">
  <div class="shell footer-top">
    <div class="footer-call">
      {/* Not the availability line any more: `site.availability` already speaks
          in the identity block above, and a display-size repeat of it spent the
          largest type in the footer on something the page had already said.
          This states the next step instead, so the sentence and the button
          below it promise the same thing. */}
      <p class="footer-line">Расскажите про задачу —<br />отвечу в Telegram.</p>
      <div class="footer-actions">
        {/* Diagonal arrow: both actions send the visitor out of the page.
            "Написать" goes to Telegram, not /contact — the line above names
            the channel, and a button landing somewhere else would break it. */}
        <a class="pill pill-accent" href={contact.telegram}>Написать<Icon name="arrow-up-right" size={15} /></a>
        <a class="pill" href={contact.cv}>Резюме<Icon name="download" size={15} /></a>
      </div>
      <p class="footer-rights">© {year} {site.name}</p>
    </div>

    <nav class="footer-nav" aria-label="Навигация в подвале">
      <p class="footer-heading">Меню</p>
      <ul>{menu.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
    </nav>

    <div class="footer-nav">
      <p class="footer-heading">Соцсети</p>
      <ul>
        {socials.map((social) => (
          <li>
            <a href={social.href}><Icon name={social.icon} size={14} />{social.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <p class="footer-ghost" aria-hidden="true" data-ghost>
    <span class="ghost-layer ghost-base">{site.handle}</span>
    <span class="ghost-layer ghost-glow">{site.handle}</span>
  </p>
</footer>

<style>
  .site-footer { position: relative; overflow: hidden; border-top: 1px solid var(--color-line); }

  .footer-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: clamp(2rem, 6vw, 6rem);
    padding-top: var(--space-2xl);
  }
  .footer-line {
    max-width: 28ch;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.6vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
  }
  .footer-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 2rem; }

  .footer-heading {
    margin-bottom: 1.1rem;
    color: var(--color-muted);
    font-family: var(--font-utility);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .footer-nav ul { display: grid; gap: 0.65rem; list-style: none; }
  .footer-nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--color-body);
    font-size: 0.95rem;
    text-decoration: none;
  }
  .footer-nav a:hover { color: var(--color-accent); }

  .footer-rights {
    margin-top: 2.25rem;
    color: var(--color-muted);
    font-family: var(--font-utility);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Oversized watermark, clipped by the footer. Decorative only — the accessible
     name of the site is already in the header and the copyright line.
     `pointer-events: none` is load-bearing, not hygiene: at this size the glyph
     ink overflows the 0.8 line box by ~70px upwards and Chrome hit-tests that
     overflow, so without it the watermark swallows the pointer well above its
     own box. The spotlight listeners are on .site-footer, not here. */
  .footer-ghost {
    position: relative;
    pointer-events: none;
    margin-top: var(--space-2xl);
    margin-bottom: -0.28em;
    font-family: var(--font-display);
    font-size: clamp(5rem, 25vw, 22rem);
    line-height: 0.8;
    letter-spacing: -0.04em;
    text-align: center;
    text-transform: uppercase;
    user-select: none;
  }
  .ghost-layer { display: block; }
  .ghost-base { color: var(--ghost-base); }

  /* The spotlight: a bright copy revealed only inside a radial mask that
     follows the pointer. Sits at opacity 0 until the pointer enters, so the
     watermark is inert by default and never animates on its own. */
  .ghost-glow {
    position: absolute;
    inset: 0;
    /* Outline, not fill: the cursor traces a thin contour around the letters
       rather than flooding them. Fill stays transparent so only the stroke reads. */
    color: transparent;
    -webkit-text-stroke: 2px var(--ghost-glow);
    text-stroke: 2px var(--ghost-glow);
    opacity: var(--spot-o, 0);
    /* GSAP tweens custom properties as raw numbers, so the unit is applied here.
       Feeding an unitless value straight into the gradient makes the whole
       mask-image invalid, which unmasks the layer and lights the entire word. */
    -webkit-mask-image: radial-gradient(
      circle var(--spot-r, 260px) at calc(var(--spot-x, 0) * 1px) calc(var(--spot-y, 0) * 1px),
      #000 0%,
      rgba(0, 0, 0, 0.5) 46%,
      transparent 72%
    );
    mask-image: radial-gradient(
      circle var(--spot-r, 260px) at calc(var(--spot-x, 0) * 1px) calc(var(--spot-y, 0) * 1px),
      #000 0%,
      rgba(0, 0, 0, 0.5) 46%,
      transparent 72%
    );
  }

  @media (max-width: 860px) {
    .footer-top { grid-template-columns: 1fr 1fr; gap: 2.5rem; }
    .footer-call { grid-column: 1 / -1; }
  }
  @media (max-width: 620px) {
    .footer-actions { display: grid; grid-template-columns: 1fr 1fr; }
    .footer-actions .pill { justify-content: center; }
  }
</style>
