---
import BaseLayout from '../layouts/BaseLayout.astro';
import Portrait from '../components/Portrait.astro';
import ExperienceBlock from '../components/ExperienceBlock.astro';
import StackGrid from '../components/StackGrid.astro';
import { site } from '../data/site';
import '../styles/routes/about.css';
---

<BaseLayout title={`Обо мне / ${site.name}`} description="Опыт, рабочий диапазон и профессиональный контекст Бакытжана Избасарова." routeClass="route-about">
  <main>
    <section class="about-intro shell">
      <Portrait />
      <div class="about-copy"><p class="utility">About</p><h1>Обо мне</h1><p>Я frontend-разработчик. Люблю интерфейсы, где визуальная часть связана с поведением: роли, состояния, навигация, ошибки и восстановление.</p><p>Основной опыт связан с React/TypeScript-продуктами STEAM.KZ. В личных проектах строю Linux-инструменты и исследую способы работы с AI-агентами.</p></div>
    </section>
    <section class="about-experience shell"><div class="route-heading"><h2>Опыт</h2><p>Одно сотрудничество с постепенным переходом от широких IT/R&D-задач к собственной frontend-зоне.</p></div><ExperienceBlock /></section>
    <section class="about-skills shell"><div class="route-heading"><h2>Стек и платформы</h2><p>Инструменты и платформы, с которыми я работал в реальных, личных и учебных проектах.</p></div><StackGrid /></section>
    <section class="about-personal shell"><div class="two-column"><h2>Personal Platform</h2><p>Тексты, эксперименты и личные инструменты живут отдельно на <a href={site.personalSite}>ex1te.pages.dev</a>. Job portfolio не дублирует Writing, Lab, Uses или Now.</p></div></section>
  </main>
</BaseLayout>
