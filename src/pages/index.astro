---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Portrait from '../components/Portrait.astro';
import SplitName from '../components/SplitName.astro';
import WorkspaceRail from '../components/WorkspaceRail.astro';
import SectionHead from '../components/SectionHead.astro';
import StackGrid from '../components/StackGrid.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { experience } from '../data/experience';
import '../styles/routes/home.css';

const work = (await getCollection('work', ({ data }) => data.published)).sort(
  (a, b) => a.data.homepageOrder - b.data.homepageOrder,
);
const [firstName, lastName] = site.name.split(' ');

/* Stage periods are rendered as sortable stamps rather than prose dates. */
const months: Record<string, string> = {
  Январь: '01', Февраль: '02', Март: '03', Апрель: '04', Май: '05', Июнь: '06',
  Июль: '07', Август: '08', Сентябрь: '09', Октябрь: '10', Ноябрь: '11', Декабрь: '12',
};
const stamp = (period: string) => {
  const [month, year] = period.split(' ');
  return months[month] && year ? `${year}/${months[month]}` : period;
};
---

<BaseLayout title={`${site.name} / ${site.role}`} description={site.description} routeClass="route-home">
  <main>
    <section class="identity shell" aria-labelledby="identity-title">
      <SectionHead index="00" name="Identity" id="identity-title" as="p" />
      <div class="identity-body">
        <div class="identity-copy">
          <SplitName first={firstName} last={lastName} label={site.name} />
          <p class="identity-role">{site.role} <span>//</span> Казахстан</p>
          <p class="identity-description">{site.description}</p>
          <div class="identity-actions">
            <a class="pill pill-accent" href="/contact"><Icon name="send-mail" size={15} />Связаться</a>
            <a class="pill" href="/work">Работы<Icon name="arrow-right" size={15} /></a>
          </div>
          <dl class="identity-facts">
            <div><dt>Статус</dt><dd class="open">{site.availability}</dd></div>
            <div><dt>Формат</dt><dd>{site.workFormats}</dd></div>
          </dl>
        </div>
        <Portrait eager={true} />
      </div>
    </section>

    <section class="workspaces-section shell" aria-labelledby="workspaces-title">
      <SectionHead index="01" name="Workspaces" id="workspaces-title" />
      <p class="section-lead">
        Четыре рабочих пространства: коммерческий frontend, offline-продукт для реального оборудования,
        Linux desktop tool и мобильное приложение.
      </p>
      <WorkspaceRail entries={work} />
    </section>

    <section class="experience-section shell" data-reveal aria-labelledby="experience-title">
      <SectionHead index="02" name="Experience" id="experience-title" />
      <p class="section-lead">
        {experience.company} <span class="sep">//</span> {experience.relationship} <span class="sep">//</span> {experience.period}
      </p>
      <ol class="timeline">
        {experience.stages.map((stage) => (
          <li>
            <span class="timeline-stamp">{stamp(stage.period)}</span>
            <span class="timeline-rule" aria-hidden="true"></span>
            <div class="timeline-body">
              <h3>{stage.title}</h3>
              <p>{stage.detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="stack-section shell" data-reveal aria-labelledby="stack-title">
      <SectionHead index="03" name="Stack" id="stack-title" />
      <StackGrid />
    </section>

  </main>
</BaseLayout>
