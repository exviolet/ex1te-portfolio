---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Portrait from '../components/Portrait.astro';
import SplitName from '../components/SplitName.astro';
import ProjectRail from '../components/ProjectRail.astro';
import SectionHead from '../components/SectionHead.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import StackGrid from '../components/StackGrid.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import '../styles/routes/home.css';

const work = (await getCollection('work', ({ data }) => data.published)).sort(
  (a, b) => a.data.homepageOrder - b.data.homepageOrder,
);
const [firstName, lastName] = site.name.split(' ');
---

<BaseLayout title={`${site.name} / ${site.role}`} description={site.description} routeClass="route-home">
  <main>
    {/* No section marker here: the h1 with the name is the page's own heading,
        and "IDENTITY // 00" labelled the person as a numbered section of a
        document he is not inside. The index now starts at the first real one. */}
    <section class="identity shell">
      <div class="identity-body">
        <div class="identity-copy">
          <SplitName first={firstName} last={lastName} label={site.name} />
          <p class="identity-role">{site.role} <span>//</span> Казахстан</p>
          <p class="identity-description">{site.description}</p>
          <div class="identity-actions">
            <a class="pill pill-accent" href="/contact"><Icon name="send-mail" size={15} />Связаться</a>
            <a class="pill" href="/work">Работы<Icon name="arrow-right" size={15} /></a>
          </div>
          <dl class="identity-facts">
            <div><dt>Статус</dt><dd class="open">{site.availability}</dd></div>
            <div><dt>Формат</dt><dd>{site.workFormats}</dd></div>
          </dl>
        </div>
        <Portrait eager={true} reveal={true} />
      </div>
    </section>

    <section class="projects-section shell" aria-labelledby="projects-title">
      <SectionHead index="01" name="Projects" id="projects-title" />
      <p class="section-lead">
        Четыре проекта: коммерческий frontend, offline-продукт для реального оборудования,
        Linux desktop tool и мобильное приложение.
      </p>
      <ProjectRail entries={work} />
    </section>

    <section class="experience-section shell" data-reveal aria-labelledby="experience-title">
      <SectionHead index="02" name="Experience" id="experience-title" />
      <ExperienceTimeline />
    </section>

    <section class="stack-section shell" data-reveal aria-labelledby="stack-title">
      <SectionHead index="03" name="Stack" id="stack-title" />
      <StackGrid />
    </section>

  </main>
</BaseLayout>
