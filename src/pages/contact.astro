---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactLinks from '../components/ContactLinks.astro';
import { site } from '../data/site';
import '../styles/routes/contact.css';
---

<BaseLayout title={`Контакты / ${site.name}`} description="Связаться с frontend-разработчиком Бакытжаном Избасаровым." routeClass="route-contact">
  <main class="contact-page shell">
    {/* No section markers: the board calls contact "одна строка", and a page
        with one block has nothing to index. */}
    <div class="contact-grid">
      <div>
        <p class="page-marker">[ Contact ]</p>
        <h1>Контакты</h1>
        <p class="contact-lead">Ищу постоянную frontend-позицию и беру проекты на фрилансе: ролевые кабинеты, аналитика, офлайн-клиенты.</p>
      </div>
      <div class="contact-details">
        <p class="contact-formats">{site.workFormats}</p>
        <ContactLinks />
      </div>
    </div>
  </main>
</BaseLayout>
