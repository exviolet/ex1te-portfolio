---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactLinks from '../components/ContactLinks.astro';
import { site } from '../data/site';
import { contact } from '../data/contact';
import '../styles/routes/contact.css';
---

<BaseLayout title={`Контакты / ${site.name}`} description="Связаться с frontend-разработчиком Бакытжаном Избасаровым." routeClass="route-contact">
  <main class="contact-page shell">
    <div class="contact-grid">
      <div><p class="utility">Contact</p><h1>Контакты</h1><p class="contact-lead">Открыт к frontend-позициям, связанным со сложными продуктовыми интерфейсами и UX-сценариями.</p></div>
      <div class="contact-details"><p>{site.workFormats}</p><ContactLinks /><p class="contact-note">{contact.note}</p></div>
    </div>
  </main>
</BaseLayout>
