---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import ProjectMedia from '../components/ProjectMedia.astro';
import Lightbox from '../components/Lightbox.astro';
import CaseBody from '../components/CaseBody.astro';
import Icon from '../components/Icon.astro';
import '../styles/routes/case.css';
import type { WorkMedia } from '../data/workMedia';
interface Props { entry: CollectionEntry<'work'>; media: WorkMedia; slug: string; html: string; }
const { entry, media, slug, html } = Astro.props;
const statusLabels = {
  production: 'Production',
  'pre-launch': 'Pre-launch',
  released: 'Released',
  building: 'In development',
} as const;

const technologies = entry.data.technologies;
const facts = [
  { label: 'Роль', value: entry.data.role },
  { label: 'Команда', value: entry.data.team },
  { label: 'Период', value: entry.data.period },
  { label: 'Статус', value: statusLabels[entry.data.status] },
];
---

<BaseLayout title={`${entry.data.title} / Бакытжан Избасаров`} description={entry.data.summary} routeClass="route-case" ogImage={`/og/${slug}.png`}>
  <main>
    <header class="case-opening shell">
      {/* Arrow points the way the action goes, like every other icon here. */}
      <a class="case-back" href="/work"><Icon name="arrow-left" size={15} />Все работы</a>
      <p class="page-marker">[ {entry.data.context} ]</p>
      <h1>{entry.data.title}</h1>
      <p class="case-summary">{entry.data.summary}</p>
      {/* Diagonal arrow, as in the footer: the link leaves the site. The label
          is the bare host, so the reader sees where it goes before clicking. */}
      {entry.data.url && (
        <a class="pill case-site" href={entry.data.url}>
          {new URL(entry.data.url).host}<Icon name="arrow-up-right" size={15} />
        </a>
      )}

      {/* One surface with hairline dividers, not four boxes. The board bans a
          1px box around every block, and the stack table already solved this
          the same way: a 1px gap over a line-coloured background draws the
          dividers at any column count. */}
      {/* Technologies are the table's second row, one cell per group, in the
          same dt/dd grammar as the facts above. A single wrapped line of ten
          names read as a list; grouped by job, the row says what each one was
          for. With fewer than four groups the last cell runs to the edge, so
          no empty cell is left hanging. */}
      <dl class="case-facts">
        {facts.map((fact) => (
          <div>
            <dt><span aria-hidden="true">//</span> {fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))}
        {technologies.map((group, index) => (
          <div class="case-facts-tech" style={index === technologies.length - 1 ? `--span: ${5 - technologies.length}` : undefined}>
            <dt><span aria-hidden="true">//</span> {group.group}</dt>
            <dd><ul>{group.items.map((item) => <li>{item}</li>)}</ul></dd>
          </div>
        ))}
      </dl>

      <ProjectMedia media={media} eager={true} zoom={true} />
      <slot name="caption" />
    </header>

    <article class="case-content shell">
      <CaseBody html={html} figures={media.figures} slug={slug} />
    </article>

    {/* No closing line here: the footer says "Расскажите про задачу" directly
        below, and two calls in a row cancel each other out. Just the exits. */}
    <section class="case-next shell">
      <div class="case-next-actions">
        <a class="pill" href="/work"><Icon name="arrow-left" size={15} />Все работы</a>
        <a class="pill pill-accent" href="/contact">Контакты<Icon name="arrow-right" size={15} /></a>
      </div>
    </section>
  </main>
  <Lightbox />
</BaseLayout>
